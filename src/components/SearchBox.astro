---
interface Props { id: string; label: string; placeholder: string }
const { id, label, placeholder } = Astro.props;
---
<div class="search">
  <label class="visually-hidden" for={id}>{label}</label>
  <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="2"/></svg>
  <input id={id} type="search" placeholder={placeholder} autocomplete="off" />
</div>
