---
// Isodose-style contour lines, the site's signature graphic.
// Nested, irregular closed curves around a target, like a treatment plan's dose lines.
interface Props { class?: string; labels?: boolean; animate?: boolean; seed?: number }
const { class: cls = '', labels = false, animate = false, seed = 7 } = Astro.props;

function rng(s: number) { return () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; }; }
const r = rng(seed);
const harmonics = Array.from({ length: 5 }, (_, k) => ({ k: k + 2, a: (0.05 + r() * 0.06) / (k + 1), p: r() * Math.PI * 2 }));

const levels = [
  { pct: '107%', scale: 0.16, color: 'var(--iso-hot, #ffd27a)', w: 1.6 },
  { pct: '95%', scale: 0.30, color: 'var(--iso-1, #ffa302)', w: 2.2 },
  { pct: '80%', scale: 0.43, color: 'var(--iso-2, #f08a00)', w: 1.6 },
  { pct: '50%', scale: 0.58, color: 'var(--iso-3, #c9772a)', w: 1.3 },
  { pct: '30%', scale: 0.73, color: 'var(--iso-4, #6d8fa1)', w: 1.1 },
  { pct: '10%', scale: 0.90, color: 'var(--iso-5, #4b6b7c)', w: 1 },
];
const C = 300;
function contour(scale: number, i: number) {
  const pts: [number, number][] = [];
  const n = 72;
  for (let j = 0; j < n; j++) {
    const t = (j / n) * Math.PI * 2;
    let rad = 1;
    for (const h of harmonics) rad += h.a * Math.sin(h.k * t + h.p + i * 0.18) * (0.6 + scale);
    // outer lines stretch slightly sideways, like a mediastinal field
    const R = 270 * scale * rad;
    pts.push([C + Math.cos(t) * R * (1 + scale * 0.18), C + Math.sin(t) * R * (0.92 - scale * 0.06)]);
  }
  // Catmull-Rom to bezier for a smooth closed path
  let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let j = 0; j < n; j++) {
    const p0 = pts[(j - 1 + n) % n], p1 = pts[j], p2 = pts[(j + 1) % n], p3 = pts[(j + 2) % n];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return { d: d + 'Z', label: pts[Math.round(n * 0.86)] };
}
const paths = levels.map((l, i) => ({ ...l, ...contour(l.scale, i) }));
---
<svg class:list={['isodose', cls, { animate }]} viewBox="0 0 640 600" aria-hidden="true" focusable="false">
  {paths.map((p, i) => (
    <g>
      <path d={p.d} fill="none" stroke={p.color} stroke-width={p.w} pathLength="1" style={`--i:${paths.length - i}`} />
      {labels && i > 0 && (
        <text x={p.label[0] + 6} y={p.label[1] - 4} fill={p.color} font-size="12" font-weight="600" style={`--i:${paths.length - i}`}>{p.pct}</text>
      )}
    </g>
  ))}
  {labels && (
    <g class="iso-center" stroke="var(--iso-1, #ffa302)" stroke-width="1">
      <line x1={C - 10} y1={C} x2={C + 10} y2={C} /><line x1={C} y1={C - 10} x2={C} y2={C + 10} />
      <circle cx={C} cy={C} r="4" fill="none" />
    </g>
  )}
</svg>

<style>
  .isodose { display: block; width: 100%; height: auto; overflow: visible; }
  .isodose text { font-family: var(--font); letter-spacing: .02em; }
  .animate path {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 1.6s cubic-bezier(.3,.6,.2,1) forwards;
    animation-delay: calc(var(--i) * 140ms);
  }
  .animate text, .animate .iso-center { opacity: 0; animation: show .6s ease forwards; animation-delay: 1.5s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes show { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .animate path { stroke-dashoffset: 0; animation: none; }
    .animate text, .animate .iso-center { opacity: 1; animation: none; }
  }
</style>
