---
import '../styles/global.css';
import site from '../data/site.json';
interface Props { title?: string; description?: string; current?: string }
const { title, description = site.mission, current = '' } = Astro.props;
const fullTitle = title ? `${title} | ILROG` : `ILROG | ${site.name}`;
import meetings from '../data/meetings.json';
const show = site.show;
// Top menu. Items with `children` open as dropdowns; `key` marks the current section.
// ILROG-NEXT sits last so it lands on the right, next to Member login.
import nx from '../data/ilrog-next.json';
const nav = [
  { label: 'About', key: 'about', children: [
    { href: '/about/', label: 'History & Objectives' },
    { href: '/team/', label: 'Team' },
  ] },
  { label: 'Meetings', key: 'meetings', children: [
    { href: '/meetings/#upcoming', label: 'Upcoming Meetings' },
    { href: '/meetings/#archive', label: 'Past Meetings' },
  ] },
  { href: '/research/', label: 'Research', key: 'research' },
  { label: 'Resources', key: 'resources', children: [
    { href: '/guidelines/', label: 'Guidelines' },
    { href: '/publications/', label: 'Publications' },
    ...(show.trainees ? [{ href: '/resources/#trainees', label: 'Resources for Trainees' }] : []),
    ...(show.residentElective ? [{ href: '/resources/#resident-elective', label: 'Resident Elective' }] : []),
    ...(show.ijrobp ? [{ href: '/resources/#ijrobp-2015', label: 'IJROBP 2015 Special Edition' }] : []),
    { href: site.youtube, label: 'YouTube' },
  ] },
  ...(show.blog ? [{ href: '/blog/', label: 'Blog', key: 'blog' }] : []),
  { label: 'Get Connected', key: 'connect', children: [
    { href: '/membership/', label: 'Membership' },
    { href: '/contact/', label: 'Contact' },
    { href: site.twitter, label: 'Twitter' },
  ] },
  { label: 'ILROG-NEXT', key: 'next', next: true, children: [
    { href: '/ilrog-next/', label: 'Overview' },
    { href: '/ilrog-next/working-groups/', label: 'Working Groups' },
    { href: '/ilrog-next/committees/', label: 'Organizational Committees' },
    { href: '/ilrog-next/conference/', label: '2027 Conference' },
  ] },
];
const next = meetings.upcoming[0];
const year = new Date().getFullYear();
const preview = !!import.meta.env.PREVIEW || !!process.env.PREVIEW;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {!site.launched && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/img/site/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="/img/site/favicon.png" />
  <link rel="apple-touch-icon" href="/img/site/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://www.ilrog.org/img/site/icon-512.png" />
  {!preview && (
    <script is:inline define:vars={{ subdomain: site.memberspaceSubdomain }}>
      // MemberSpace install code (same as the current Squarespace site). Powers member login,
      // the floating Members button, plan signup and any members-only pages set in the MemberSpace dashboard.
      window.MemberSpace = window.MemberSpace || { subdomain: subdomain };
      (function (d) {
        var s = d.createElement('script');
        s.src = 'https://cdn.memberspace.com/scripts/widgets.js';
        var e = d.getElementsByTagName('script')[0];
        e.parentNode.insertBefore(s, e);
      })(document);
    </script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {next && (
    <a class="announce" href={next.id === 'ilrog-next-2027' ? '/ilrog-next/conference/' : `/meetings/#${next.id}`}>
      <span><strong>Upcoming:</strong> {next.dates}, {next.title}, {next.city.replace(', USA', '')}</span>
    </a>
  )}
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="ILROG home"><img src="/img/site/logo.png" alt="ILROG, International Lymphoma Radiation Oncology Group" width="148" height="51" /></a>
      <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="2" /></svg>
        Menu
      </button>
      <nav class="nav" id="site-nav" aria-label="Main">
        <ul class="nav-list">
          {nav.map((n, i) => n.children ? (
            <li class:list={['has-sub', { 'is-next': n.next }]}>
              <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`sub-${i}`} aria-current={current === n.key ? 'true' : undefined}>
                {n.next ? <span class="nx-label">ILROG<span>-NEXT</span></span> : n.label}
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
              <ul class="sub" id={`sub-${i}`}>
                {n.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li><a class="top-link" href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <a class="login" href={site.loginUrl}>Member login</a>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <img class="foot-logo" src="/img/site/logo-light.png" alt="ILROG" width="150" height="52" loading="lazy" />
          <p>The International Lymphoma Radiation Oncology Group, founded in {site.founded}.</p>
        </div>
        <div>
          <h3>Contact</h3>
          <address>
            {site.address.map((l) => <>{l}<br /></>)}
          </address>
          <p style="margin-top:.8rem"><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        </div>
        <div>
          <h3>Resources</h3>
          <ul>
            <li><a href="/guidelines/">Guidelines</a></li>
            <li><a href="/publications/">Publications</a></li>
            {show.trainees && <li><a href="/resources/#trainees">Resources for Trainees</a></li>}
            {show.residentElective && <li><a href="/resources/#resident-elective">Resident Elective</a></li>}
            <li><a href="/meetings/#archive">Past Meetings</a></li>
          </ul>
        </div>
        <div>
          <h3>Organization</h3>
          <ul>
            <li><a href="/team/">Team</a></li>
            <li><a href="/membership/">Membership</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href={site.twitter}>Twitter</a></li>
            <li><a href={site.youtube}>YouTube</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-base">
        <span>© {year} International Lymphoma Radiation Oncology Group</span>
        <a href={site.loginUrl}>Member login</a>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.querySelector('.menu-btn');
    const nav = document.getElementById('site-nav');
    btn?.addEventListener('click', () => {
      const open = nav!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    // Dropdowns: open on hover (desktop, via CSS) or on click/tap/keyboard (here).
    const items = [...document.querySelectorAll<HTMLElement>('.has-sub')];
    const close = (except?: HTMLElement) => items.forEach((li) => {
      if (li === except) return;
      li.classList.remove('open');
      li.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false');
    });
    items.forEach((li) => {
      const t = li.querySelector<HTMLButtonElement>('.sub-toggle')!;
      t.addEventListener('click', () => {
        const open = !li.classList.contains('open');
        close(li);
        li.classList.toggle('open', open);
        t.setAttribute('aria-expanded', String(open));
      });
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { close(); t.focus(); }
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.has-sub')) close();
    });
  </script>
</body>
</html>
