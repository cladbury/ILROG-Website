---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ResearchItem from '../../components/ResearchItem.astro';
import trials from '../../data/trials.json';
import studies from '../../data/studies.json';
import site from '../../data/site.json';
const active = trials.filter((t: any) => !t.completed);
---
<Base title="Ongoing Research" current="research" description="Ongoing ILROG consortium clinical trials and collaborative studies in lymphoma and myeloma radiotherapy.">
  <PageHead title="Ongoing Research" intro="ILROG member institutions run prospective trials and multicenter studies on radiation dose, technique and outcomes." />
  <section class="section">
    <div class="wrap">
      {active.length > 0 && <h2 class="sec-h">ILROG Consortium Clinical Trials</h2>}
      {active.length > 0 && <div class="list">{active.map((t) => <ResearchItem item={t} trial />)}</div>}
      <h2 class="sec-h" id="collaborative">Collaborative Studies Open to ILROG Centers</h2>
      <div class="list">{studies.open.map((t) => <ResearchItem item={t} />)}</div>
      <div class="protocols">
        <p>To join a study at your institution, or to propose a new ILROG study, contact <a href={`mailto:${site.email}`}>{site.contactName}</a>. Finished studies are listed under <a href="/research/completed/">Completed Research</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-h { margin-bottom: 1.5rem; }
  .sec-h + .list { border-top: 2px solid var(--ink); }
  .list + .sec-h { margin-top: 4rem; }
  .protocols { background: var(--mist); border-radius: var(--radius); padding: 1.5rem 1.75rem; margin-top: 1rem; }
  .protocols p { margin: 0; }
</style>
