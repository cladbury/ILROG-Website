---
import NextShell from '../../../components/NextShell.astro';
import PersonCard from '../../../components/PersonCard.astro';
import nx from '../../../data/ilrog-next.json';
export function getStaticPaths() {
  return nx.workingGroups.map((g, i) => ({ params: { slug: g.slug }, props: { g, i } }));
}
const { g, i } = Astro.props;
const all = nx.workingGroups;
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
// other groups that share a person with this one
const people = new Set([...g.mentors, ...g.coleads, ...g.members]);
const related = all.filter((o) => o.slug !== g.slug && [...o.mentors, ...o.coleads, ...o.members].some((p) => people.has(p)));
---
<NextShell title={`${g.name} | ILROG-NEXT`} heading={g.name} active="groups" crumb={{ href: '/ilrog-next/working-groups/', label: 'Working groups' }}
  description={`ILROG-NEXT ${g.name} working group: senior mentors, co-leaders and members.`}>
  <section class="section">
    <div class="wrap people-grid">
      <div class="col">
        <h2>{g.coleads.length === 1 ? 'Co-leader' : 'Co-leaders'}</h2>
        <div class="stack">{g.coleads.map((n) => <PersonCard name={n} size="lg" email />)}</div>
      </div>
      <div class="col">
        <h2>{g.mentors.length === 1 ? 'Senior mentor' : 'Senior mentors'}</h2>
        <div class="stack">{g.mentors.map((n) => <PersonCard name={n} size="lg" email />)}</div>
      </div>
      {g.members.length > 0 && (
        <div class="col">
          <h2>Members</h2>
          <div class="stack">{g.members.map((n) => <PersonCard name={n} />)}</div>
        </div>
      )}
    </div>
  </section>


  <section class="section">
    <div class="wrap">
      {related.length > 0 && (
        <div class="related">
          <h2>Connected working groups</h2>
          <p class="muted">These groups share mentors, leaders or members with {g.name}.</p>
          <ul>{related.map((o) => <li><a href={`/ilrog-next/working-groups/${o.slug}/`}>{o.name}</a></li>)}</ul>
        </div>
      )}
      <nav class="pn" aria-label="Other working groups">
        <a href={`/ilrog-next/working-groups/${prev.slug}/`}><span>Previous</span>{prev.name}</a>
        <a href={`/ilrog-next/working-groups/${next.slug}/`} class="nx"><span>Next</span>{next.name}</a>
      </nav>
    </div>
  </section>
</NextShell>
<style>
  .people-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 3rem; }
  .col h2 { font-size: 1.1rem; padding-bottom: .7rem; border-bottom: 2px solid var(--ink); margin-bottom: 1.25rem; }
  .stack { display: grid; gap: 1.1rem; }
  @media (max-width: 900px) { .people-grid { grid-template-columns: 1fr; } }
  .related { margin-bottom: 3rem; }
  .related h2 { font-size: 1.35rem; }
  .related ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .related a { display: inline-block; border: 1px solid var(--line); border-radius: 99px; padding: .45rem 1rem; text-decoration: none; color: var(--ink); font-weight: 500; }
  .related a:hover { border-color: var(--next-orange); }
  .pn { display: flex; justify-content: space-between; gap: 1rem; border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .pn a { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); font-weight: 600; }
  .pn a span { font-size: .8rem; color: var(--steel); font-weight: 500; }
  .pn .nx { text-align: right; }
  .pn a:hover { color: var(--next-orange-ink); }
</style>
