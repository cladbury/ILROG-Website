---
import NextShell from '../../components/NextShell.astro';
import NextMark from '../../components/NextMark.astro';
import PersonCard from '../../components/PersonCard.astro';
import nx from '../../data/ilrog-next.json';
import site from '../../data/site.json';
const c = nx.conference;
---
<NextShell title="ILROG-NEXT" active="overview" description={nx.tagline}>
  <Fragment slot="head">
    <div class="ov-hero">
      <div>
        <h1 class="ov-title">Shaping the next chapter of lymphoma radiation oncology</h1>
        <p class="ov-lede">{nx.tagline}</p>
        <div class="ov-actions">
          <a class="btn nx-btn" href="/ilrog-next/working-groups/">Explore the working groups</a>
          <a class="btn btn-outline-ink" href="#get-involved">Get involved</a>
        </div>
      </div>
      <a class="save" href="/ilrog-next/conference/">
        <span class="kick">Save the date</span>
        <span class="st">{c.title}</span>
        <span class="sd">{c.dates}</span>
        <span class="sv">{c.venue}, {c.city.replace(', Massachusetts', '')}</span>
        <span class="sa">{c.access}</span>
      </a>
    </div>
  </Fragment>

  <section class="section">
    <div class="wrap">
      <h2>Mission</h2>
      <ul class="aims">
        {nx.mission.map((m) => <li>{m}</li>)}
      </ul>
      <p class="note">ILROG-NEXT is a separate but related effort. It draws leadership and participation from every tier of ILROG and does not replace the existing structure.</p>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap">
      <div class="section-head"><h2>Working groups</h2><a href="/ilrog-next/working-groups/">All working groups</a></div>
      <p class="muted sub">Topic-focused groups, each with senior mentors, co-leaders and members from across the ILROG community.</p>
      <ul class="wg-grid">
        {nx.workingGroups.map((g) => (
          <li>
            <a href={`/ilrog-next/working-groups/${g.slug}/`}>
              <span class="wn">{g.name}</span>
              <span class="wl">{g.coleads.length === 1 ? 'Co-leader' : 'Co-leaders'}: {g.coleads.join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/ilrog-next/committees/">Organizational committees</a> cover mentorship, membership and early-career engagement, education, AI and data science, advocacy, social media, and collaborations.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap lead-grid">
      <div>
        <h2>Leadership</h2>
        <p class="muted">A steering committee of senior ILROG leaders guides the initiative. The co-leaders run it day to day and connect the steering committee with each working group.</p>
      </div>
      <div>
        <h3 class="lh">Co-leaders</h3>
        <div class="co">
          {nx.coleaders.map((p) => <PersonCard name={p.name} size="lg" role="ILROG-NEXT Co-leader" email />)}
        </div>
        <h3 class="lh">Steering committee</h3>
        <div class="steer">
          {nx.steering.map((n) => <PersonCard name={n} email />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="get-involved">
    <div class="wrap gi">
      <div>
        <h2>Get involved</h2>
        <p>Inclusion is a guiding principle of ILROG-NEXT. Working group leaders invite the members they need, and new volunteers are welcome, including trainees and early-career faculty.</p>
        <p>All ILROG-NEXT participants should be at least General Members of ILROG.</p>
      </div>
      <div class="gi-actions">
        <a class="btn nx-btn" href={site.joinUrl}>Become a General Member</a>
        <a class="btn btn-outline-ink" href={`mailto:${site.email}?subject=ILROG-NEXT`}>Contact ILROG about ILROG-NEXT</a>
      </div>
    </div>
  </section>
</NextShell>

<style>
  .ov-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .8fr); gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .ov-title { font-size: clamp(2rem, 4vw, 3.1rem); max-width: 18ch; }
  .ov-title::after { content: ""; display: block; width: 2.6rem; height: 3px; background: var(--next-orange); margin-top: 1rem; }
  .ov-lede { font-size: 1.15rem; color: var(--steel); max-width: 56ch; }
  .ov-actions, .gi-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .save { display: grid; gap: .25rem; background: var(--ink); color: var(--paper); text-decoration: none; padding: 1.6rem 1.7rem; border-radius: var(--radius); border-top: 4px solid var(--next-orange); }
  .save:hover { color: var(--paper); background: var(--ink-2); }
  .kick { font-size: .8rem; font-weight: 600; color: var(--next-orange); letter-spacing: .02em; }
  .st { font-size: 1.25rem; font-weight: 700; }
  .sd { font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; margin-top: .4rem; }
  .sv { color: var(--fog); }
  .sa { margin-top: .6rem; font-size: .85rem; font-weight: 600; justify-self: start; border: 1px solid rgba(255,255,255,.4); border-radius: 99px; padding: .2rem .7rem; }
  @media (max-width: 860px) { .ov-hero { grid-template-columns: 1fr; } }

  .aims { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0 3rem; border-top: 2px solid var(--ink); }
  .aims li { position: relative; padding: 1.05rem 0 1.05rem 1.5rem; border-bottom: 1px solid var(--line); font-weight: 500; }
  .aims li::before { content: ""; position: absolute; left: 0; top: 1.5rem; width: .55rem; height: .55rem; background: var(--next-teal); }
  .aims li:nth-child(odd)::before { background: var(--next-orange); }
  .note { margin-top: 1.5rem; color: var(--steel); }

  .sub { margin-top: -1rem; }
  .wg-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .wg-grid a { display: flex; flex-direction: column; gap: .4rem; height: 100%; padding: 1.2rem 1.25rem; background: var(--paper); border-radius: var(--radius); border-left: 4px solid var(--next-orange); text-decoration: none; color: var(--ink); }
  .wg-grid li:nth-child(even) a { border-left-color: var(--next-teal); }
  .wg-grid a:hover .wn { text-decoration: underline; }
  .wn { font-weight: 700; font-size: 1.08rem; }
  .wl { font-size: .875rem; color: var(--steel); }
  .more { margin-top: 1.5rem; }

  .lead-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); gap: clamp(2rem, 5vw, 4rem); }
  .lh { font-size: 1rem; color: var(--steel); margin: 0 0 1rem; }
  .co { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 2.25rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .steer { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.1rem 1.5rem; }
  @media (max-width: 860px) { .lead-grid, .co { grid-template-columns: 1fr; } }


  .gi { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem 4rem; align-items: center; }
  @media (max-width: 860px) { .gi { grid-template-columns: 1fr; } }
</style>
