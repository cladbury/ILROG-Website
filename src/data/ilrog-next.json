{
 "tagline": "A transformation initiative of the International Lymphoma Radiation Oncology Group, bringing together leaders across the world to shape the next generation of guidance, evidence, and collaboration.",
 "mission": [
  "Create clear pathways for ILROG to engage early and mid-career faculty",
  "Convene contemporary topic-focused working groups to advance priority questions",
  "Foster cross-committee collaboration so ideas and evidence move between groups",
  "Offer opportunities for mentorship, leadership and growth",
  "Create a professional community of hematologic-focused radiation oncologists",
  "Critically revisit how academic and clinical information is generated and disseminated for maximal reach"
 ],
 "steering": [
  "Joachim Yahalom",
  "Bouthaina Dabaja",
