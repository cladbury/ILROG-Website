  }
 ],
 "timeline": [
  {
   "when": "Late 2025",
   "title": "Vision defined",
   "text": "Initial ILROG leadership discussions on broader engagement of early and mid-career faculty."
  },
  {
   "when": "March 2026",
   "title": "Initial brainstorming",
   "text": "Feedback and engagement during the Princess Margaret ILROG conference in Toronto."
  },
  {
   "when": "April-June 2026",
   "title": "Committee structure drafted",
   "text": "Designed to be inclusive and to create leadership opportunities for as many members as possible."
  },
  {
   "when": "July 2026",
   "title": "Working group kickoff",
   "text": "Leaders convened to align, build their committees and begin the work."
  },
  {
   "when": "June 2027",
   "title": "ILROG-NEXT Conference",
   "text": "Massachusetts General Hospital, Boston."
  }
 ],
 "mentorRole": [
  {
   "title": "Define the key open questions",
   "text": "Help frame the most important, contemporary questions each group should tackle."
  },
  {
   "title": "Identify opportunities for members",
   "text": "Spot projects, collaborations and visibility opportunities for committee members."
  },
  {
   "title": "Promote ILROG and ILROG-NEXT",
   "text": "Champion the initiative, both informally and through formal channels."
  },
  {
   "title": "Career advancement and mentorship",
   "text": "Offer career advice and mentorship to support members' professional growth."
  }
 ],
